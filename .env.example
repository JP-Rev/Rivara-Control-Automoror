# Copiar a .env y completar. El .env NUNCA se commitea.

# --- Sesion -----------------------------------------------------------------
# El MISMO valor que en el .env de Rivara-Intranet: es lo que hace que entrar
# al portal alcance para entrar a esta app (cookie rivara_he).
JWT_SECRET=

# Usuario de emergencia, opcional: solo para entrar si el portal esta caido y
# nadie definio todavia su contrasena de respaldo. Minimo 8 caracteres.
AUTOMOTOR_ADMIN_EMAIL=
AUTOMOTOR_ADMIN_PASSWORD=

# --- Red Windows: de donde se leen las planillas de flota ----------------------
# Credenciales de Windows con permiso de LECTURA sobre el recurso compartido.
# Conviene una cuenta de servicio de solo lectura y no la personal: queda
# escrita en este archivo del servidor.
SMB_USUARIO=
SMB_PASSWORD=
# El dominio de Windows (RIVARA) o, si no hay dominio, el grupo de trabajo o
# el nombre del equipo que comparte. Vacio si el usuario es local del server.
SMB_DOMINIO=
# IP de \\server. El contenedor no resuelve nombres NetBIOS: si el DNS de la
# red no conoce "server", sin esto no lo encuentra.
SMB_IP=
# Solo si \\server es un Windows muy viejo que no habla SMB2: NT1
SMB_PROTOCOLO_MINIMO=

# Rutas de las planillas, tal como se ven en el Explorador de Windows. Si no
# se definen, se usan estas. Si el nombre no coincide exacto (espacios,
# mayusculas), la app busca uno parecido en la carpeta.
PLANILLA_CAMIONETAS='\\server\Rivara Transportes y logistica\Camionetas\Camionetas.xlsx'
PLANILLA_CAMIONES='\\server\Rivara Transportes y logistica\Camiones\Control Camiones.xlsx'

# Minutos minimos entre dos lecturas automaticas de la red (al entrar a la app).
SYNC_MINUTOS=10

# --- DDJJ de extravio -----------------------------------------------------------
DDJJ_LUGAR=Buenos Aires
# Seccional del Registro que va en "Secc:" (se puede cambiar en cada DDJJ).
DDJJ_SECCIONAL=01292
# A quien va dirigido el Anexo 08 D ("Al Sr. Encargado del Registro
# Automotor: ..."). Vacio = "Registro Seccional Nº <DDJJ_SECCIONAL>".
DDJJ_REGISTRO=Registro Seccional Nº 01292 - Alberti

# --- Transferencia Digital del DNRPA (bot) --------------------------------------
# Contacto que el bot carga en el sitio para vendedor y comprador. Vacio = estos.
DNRPA_EMAIL=jreale@rivara.com.ar
DNRPA_TELEFONO=2346472000
